---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { defaultLocale, localePath, locales, t } from "../i18n";

// Vercel serves this one page for every missing URL, so it speaks every language, English first.
const m = t(defaultLocale).notFound;
const others = locales
  .filter((locale) => locale !== defaultLocale)
  .map((locale) => ({ locale, m: t(locale).notFound, home: localePath(locale, "/") }));
---

<Base title={`${m.title} · Alex Wade`} description={m.body} indexable={false}>
  <Header />
  <main id="main" class="container">
    <h1 id="top">{m.heading}</h1>
    <p>{m.body}</p>
    <p>
      <a href="/">{m.home}</a>
    </p>
    {others.map((other) => (
      <div class="other" lang={other.locale}>
        <h2>{other.m.heading}</h2>
        <p>{other.m.body}</p>
        <p>
          <a href={other.home}>{other.m.home}</a>
        </p>
      </div>
    ))}
  </main>
</Base>

<style>
  main {
    padding-block: 88px 160px;
  }

  h1 {
    max-width: 16ch;
    margin: 0 0 24px;
    font-size: var(--text-statement);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--slate);
  }

  p + p {
    margin-top: 24px;
  }

  .other {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  h2 {
    margin: 0 0 16px;
    font-size: 22px;
    font-weight: 500;
  }

  a {
    display: inline-block;
    padding-block: 12px;
  }
</style>
