---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { t } from "../i18n";

const m = t().notFound;
---

<Base title={`${m.title} · Alex Wade`} description={m.body}>
  <Header base="/" />
  <main id="main" class="container">
    <h1 id="top">{m.heading}</h1>
    <p>{m.body}</p>
    <p>
      <a href="/">{m.home}</a>
    </p>
  </main>
</Base>

<style>
  main {
    padding-block: 88px 160px;
  }

  h1 {
    max-width: 16ch;
    margin: 0 0 24px;
    font-size: var(--text-statement);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--slate);
  }

  p + p {
    margin-top: 24px;
  }

  a {
    display: inline-block;
    padding-block: 12px;
  }
</style>
