---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n";

const m = t();
---

<Base title={`${m.colophon.title} · Alex Wade`} description={m.colophon.description}>
  <Header base="/" />
  <main id="main" class="container">
    <h1 id="top">{m.colophon.title}</h1>
    {m.colophon.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class:list={{ todo: paragraph.startsWith("TODO") }}>{paragraph}</p>
        ))}
      </section>
    ))}
    <p class="back">
      <a href="/">{m.colophon.back}</a>
    </p>
  </main>
  <Footer />
</Base>

<style>
  main {
    padding-block: 88px 96px;
  }

  h1 {
    max-width: 16ch;
    margin: 0 0 56px;
    font-size: var(--text-statement);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  section {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 80px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--rule);
  }

  h2 {
    flex: 1 1 200px;
    margin: 0;
    font-size: 15px;
    font-weight: 500;
  }

  section > p {
    flex: 1.6 1 480px;
    max-width: 62ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--slate);
  }

  section > p + p {
    margin-top: 16px;
  }

  .todo {
    color: var(--redline);
  }

  .back a {
    display: inline-block;
    padding-block: 12px;
    font-size: 15px;
  }
</style>
