---
import { Picture } from "astro:assets";
import { t, toLocale } from "../i18n";
import stringLights from "../assets/alex-string-lights.jpg";
import ExhibitSpecimen from "./ExhibitSpecimen.astro";
import ExhibitShell from "./ExhibitShell.astro";
import ExhibitCode from "./ExhibitCode.astro";

const locale = toLocale(Astro.currentLocale);
const m = t(locale);
---

<section class="band container" aria-label={m.band.label} data-band>
  <div class="band-inner">
    <figure>
      <Picture
        src={stringLights}
        formats={["avif", "webp"]}
        widths={[320, 640, 960]}
        sizes="320px"
        width={320}
        height={360}
        alt={m.band.photoAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="photo curtain"
      />
      <figcaption>
        {m.band.creditPrefix} <a href={m.band.creditUrl}>{m.band.creditName}</a>
      </figcaption>
    </figure>

    {/* Decorative: each panel illustrates the headline word it rotates in with. */}
    <div class="exhibit" aria-hidden="true">
      <ExhibitSpecimen />
      <ExhibitShell />
      <ExhibitCode />
    </div>

    <button type="button" class="motion-toggle js-only" data-motion-toggle>
      <span data-when="running">
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <rect x="2" y="1" width="3" height="10" rx="0.5" />
          <rect x="7" y="1" width="3" height="10" rx="0.5" />
        </svg>
        <span class="text">{m.band.pause}</span>
      </span>
      <span data-when="paused">
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <path d="M3 1.2v9.6a.5.5 0 0 0 .76.43l7.6-4.8a.5.5 0 0 0 0-.86l-7.6-4.8A.5.5 0 0 0 3 1.2z" />
        </svg>
        <span class="text">{m.band.play}</span>
      </span>
    </button>
  </div>
</section>

<style>
  .band-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-bottom: 72px;
  }

  figure {
    flex: 0 0 320px;
    max-width: 100%;
    margin: 0;
  }

  figure :global(.photo) {
    width: 100%;
    height: 360px;
    object-fit: cover;
    object-position: 50% 28%;
  }

  figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  figcaption a {
    color: var(--muted);
  }

  figcaption a:hover {
    color: var(--redline);
  }

  .exhibit {
    display: grid;
    flex: 1 1 420px;
    min-width: 0;
    height: 360px;
    overflow: hidden;
    background: var(--panel);
  }

  /*
   * A quiet text button: muted, with a pause or play icon, and the nav's underline on hover. The label is 6:1 on the
   * paper, and the button keeps a 44px-tall target. motion.css handles which label shows.
   */
  .motion-toggle {
    position: absolute;
    right: 0;
    bottom: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 14px var(--font-sans);
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }

  .motion-toggle > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  svg {
    flex: none;
    fill: currentColor;
  }

  /* The same 1px underline as the nav links, grown from the left, 5px below the text. */
  .text {
    padding-block: 5px;
    line-height: 20px;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size 0.35s var(--ease);
  }

  /* Touch screens skip it, because a tapped button stays hovered. */
  @media (hover: hover) {
    .motion-toggle:hover {
      color: var(--ink);
    }

    .motion-toggle:hover .text {
      background-size: 100% 1px;
    }
  }
</style>
