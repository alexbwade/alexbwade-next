---
import { Picture } from "astro:assets";
import { t } from "../i18n";
import courtyard from "../assets/alex-courtyard.jpg";
import ExhibitSpecimen from "./ExhibitSpecimen.astro";
import ExhibitShell from "./ExhibitShell.astro";
import ExhibitCode from "./ExhibitCode.astro";
import SpecNote from "./SpecNote.astro";

const m = t();
---

<section class="band container" aria-label={m.band.label} data-band>
  <div class="band-inner">
    <figure>
      <Picture
        src={courtyard}
        formats={["avif", "webp"]}
        widths={[320, 640, 960]}
        sizes="320px"
        width={320}
        height={360}
        alt={m.band.photoAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="photo curtain"
      />
      <figcaption>
        {m.band.creditPrefix} <a href={m.band.creditUrl}>{m.band.creditName}</a>
      </figcaption>
    </figure>

    {/* Decorative: each panel illustrates the headline word it rotates in with. */}
    <div class="exhibit" aria-hidden="true">
      <ExhibitSpecimen />
      <ExhibitShell />
      <ExhibitCode />
    </div>

    <SpecNote style="left: 0; bottom: 12px; width: 320px; white-space: normal">{m.spec.photo}</SpecNote>
    <SpecNote style="left: 344px; bottom: 12px; max-width: calc(100% - 524px); white-space: normal">
      {m.spec.exhibit}
    </SpecNote>
    <SpecNote style="right: 0; bottom: 56px">{m.spec.pause}</SpecNote>
    <button type="button" class="btn motion-toggle js-only" data-toggle="motion">
      <span data-when="running">{m.band.pause}</span>
      <span data-when="paused">{m.band.play}</span>
    </button>
  </div>
</section>

<style>
  .band-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-bottom: 72px;
  }

  figure {
    flex: 0 0 320px;
    max-width: 100%;
    margin: 0;
  }

  figure :global(.photo) {
    width: 100%;
    height: 360px;
    object-fit: cover;
    object-position: 50% 28%;
  }

  figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  figcaption a {
    color: var(--muted);
  }

  figcaption a:hover {
    color: var(--redline);
  }

  .exhibit {
    display: grid;
    flex: 1 1 420px;
    min-width: 0;
    height: 360px;
    overflow: hidden;
    background: var(--panel);
  }

  .motion-toggle {
    position: absolute;
    right: 0;
    bottom: 8px;
  }
</style>
