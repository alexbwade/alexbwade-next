---
import { t } from "../i18n";
import SpecNote from "./SpecNote.astro";

const m = t();
---

<footer id="contact" class="container" aria-labelledby="contact-label">
  <div class="footer">
    <h2 id="contact-label" class="section-label">
      {m.contact.label}
    </h2>
    <a class="email" href={`mailto:${m.contact.email}`}>
      {m.contact.email}
    </a>
    <div class="meta">
      <span>{m.contact.location}</span>
      <a href="/colophon">{m.contact.colophonLink}</a>
    </div>
    <SpecNote style="left: 0; bottom: 20px">{m.spec.footer}</SpecNote>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: 28px 56px;
    border-top: 1px solid var(--rule);
  }

  .section-label {
    margin-bottom: 40px;
  }

  .email {
    display: inline-block;
    padding-block: 4px;
    font-size: var(--text-email);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration-thickness: 1px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    margin-top: 56px;
    font-size: 15px;
    color: var(--muted);
  }

  .meta a {
    display: inline-block;
    padding-block: 12px;
  }
</style>
