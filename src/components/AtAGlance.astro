---
import { t, toLocale } from "../i18n";
import { publicFileSize } from "../lib/fileSize";

const locale = toLocale(Astro.currentLocale);
const m = t(locale).glance;
const resumeMeta = m.resumeMeta.replace("{size}", publicFileSize("alex-wade-resume.pdf"));
---

<section class="glance container" aria-label={m.label}>
  <div class="glance-inner">
    <dl>
      {m.facts.map(({ term, value }) => (
        <div>
          <dt>{term}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <a class="resume" href="/alex-wade-resume.pdf" type="application/pdf" target="_blank" rel="noopener">
      {m.resume} <span>{resumeMeta}</span>
      <span class="visually-hidden">{m.newTab}</span>
    </a>
  </div>
</section>

<style>
  .glance-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-block: 28px 96px;
    border-top: 1px solid var(--rule);
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 56px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 2px 0 0;
    font-weight: 500;
  }

  /* The fill sweeps in from the left on hover, the same way and with the same timing as the .btn fill. */
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--radius);
    background: linear-gradient(var(--redline), var(--redline)) no-repeat 0 0 / 0 100% var(--ink);
    color: var(--paper);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-size 0.35s var(--ease);
  }

  .resume:hover {
    color: var(--paper);
  }

  .resume span {
    font-weight: 400;
    color: var(--border);
    transition: color 0.35s var(--ease);
  }

  /* Touch screens skip it, because a tapped button stays hovered. */
  @media (hover: hover) {
    .resume:hover {
      background-size: 100% 100%;
    }

    /* --border is 3.7:1 on the redline, short of the 4.5:1 that 16px text needs. --panel is 5:1. */
    .resume:hover span {
      color: var(--panel);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume,
    .resume span {
      transition: none;
    }
  }
</style>
