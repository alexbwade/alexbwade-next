---
import { cleanPath, localePath, locales, t, toLocale, unlocalizedPath } from "../i18n";

const locale = toLocale(Astro.currentLocale);
const m = t(locale);
const path = unlocalizedPath(cleanPath(Astro.url.pathname));
// On the home page the nav links are in-page anchors; elsewhere they lead back to the home page first.
const home = path === "/" ? "" : localePath(locale, "/");
// The same page in each other language. The 404 page already shows every language, so it gets no switcher.
const alternates = locales
  .filter((other) => other !== locale && path !== "/404")
  .map((other) => ({ locale: other, href: localePath(other, path), label: t(other).languageName }));
---

<a class="skip-link" href="#main">
  {m.header.skipLink}
</a>
<header class="header container">
  <a class="home" href={`${home}#top`}>
    {m.header.home}
  </a>
  <nav aria-label={m.header.navLabel}>
    <ul>
      {m.header.nav.map(({ href, label }) => (
        <li>
          <a href={`${home}${href}`}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="actions">
    {alternates.map((alternate) => (
      <a class="language" href={alternate.href} hreflang={alternate.locale} lang={alternate.locale}>
        {alternate.label}
      </a>
    ))}
    <a class="btn resume" href="/alex-wade-resume.pdf" type="application/pdf" target="_blank" rel="noopener">
      {m.header.resume}
      <span class="visually-hidden">{m.glance.newTab}</span>
    </a>
  </div>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 24px;
    /* Sticks once it has scrolled up 16px, so the stuck bar is shorter than the resting one. */
    position: sticky;
    top: -16px;
    z-index: 5;
  }

  /* The bar's backdrop, full-bleed although the header itself is container width. body clips the overflow. */
  .header::before,
  .header::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    pointer-events: none;
  }

  .header::before {
    inset-block: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 var(--rule);
  }

  /* Reading progress: a redline that draws across the bottom of the bar as the page scrolls. */
  .header::after {
    bottom: -1px;
    height: 2px;
    background: var(--redline);
    transform-origin: left;
    transform: scaleX(0);
  }

  /*
   * Everything is tied to scroll position, so it runs on the compositor and tracks the scrollbar exactly. Browsers
   * without scroll-driven animations get the plain frosted bar above.
   */
  @supports (animation-timeline: scroll()) {
    .header::before {
      animation: header-fill linear both;
      animation-timeline: scroll();
      animation-range: 0 96px;
    }

    .header::after {
      animation: header-progress linear both;
      animation-timeline: scroll();
    }

    /* Shifts the contents down half the 16px the bar loses, so they stay centred in it. */
    .header > * {
      animation: header-settle linear both;
      animation-timeline: scroll();
      animation-range: 0 16px;
    }
  }

  @keyframes header-fill {
    from {
      opacity: 0;
      box-shadow: 0 1px 0 transparent;
    }
  }

  @keyframes header-progress {
    to {
      transform: none;
    }
  }

  @keyframes header-settle {
    to {
      translate: 0 var(--settle, 8px);
    }
  }

  .home {
    padding-block: 12px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .language {
    display: block;
    padding-block: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .language:hover {
    color: var(--redline);
  }

  .resume {
    border-color: var(--redline);
    color: var(--redline);
    text-decoration: none;
  }

  .resume:hover {
    background: var(--redline);
    color: var(--paper);
  }

  /* On phones, keep the language and résumé links beside the name and give the nav its own row. */
  @media (max-width: 600px) {
    nav {
      flex-basis: 100%;
      order: 1;
    }

    /*
     * Two rows is too tall to keep on a phone screen, so the name row scrolls away and only the nav row sticks:
     * 24px padding + the 44px row + the 12px gap. The settle then moves the links 10px down to centre them.
     */
    .header {
      --settle: 10px;
      top: -80px;
    }

    .header > * {
      animation-range: 60px 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header > * {
      animation: none;
    }
  }

  nav a {
    display: block;
    padding-block: 12px;
    text-decoration: none;
  }
</style>
