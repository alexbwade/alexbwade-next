---
import { t } from "../i18n";

interface Props {
  /** Prefix for the in-page nav links, so they work from other pages. */
  base?: string;
}

const { base = "" } = Astro.props;
const m = t();
---

<a class="skip-link" href="#main">
  {m.header.skipLink}
</a>
<header class="header container">
  <a class="home" href={`${base}#top`}>
    {m.header.home}
  </a>
  <nav aria-label={m.header.navLabel}>
    <ul>
      {m.header.nav.map(({ href, label }) => (
        <li>
          <a href={`${base}${href}`}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="btn resume" href="/alex-wade-resume.pdf" type="application/pdf" target="_blank" rel="noopener">
    {m.header.resume}
    <span class="visually-hidden">{m.glance.newTab}</span>
  </a>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 24px;
  }

  .home {
    padding-block: 12px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .resume {
    border-color: var(--redline);
    color: var(--redline);
    text-decoration: none;
  }

  .resume:hover {
    background: var(--redline);
    color: var(--paper);
  }

  /* On phones, keep the résumé link beside the name and give the nav its own row. */
  @media (max-width: 600px) {
    nav {
      flex-basis: 100%;
      order: 1;
    }
  }

  nav a {
    display: block;
    padding-block: 12px;
    text-decoration: none;
  }
</style>
