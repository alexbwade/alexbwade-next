---
import { cleanPath, localePath, locales, t, toLocale, unlocalizedPath } from "../i18n";

const locale = toLocale(Astro.currentLocale);
const m = t(locale);
const path = unlocalizedPath(cleanPath(Astro.url.pathname));
// On the home page the nav links are in-page anchors; elsewhere they lead back to the home page first.
const home = path === "/" ? "" : localePath(locale, "/");
// The same page in each other language. The 404 page already shows every language, so it gets no switcher.
const alternates = locales
  .filter((other) => other !== locale && path !== "/404")
  .map((other) => ({ locale: other, href: localePath(other, path), label: t(other).languageName }));
---

<a class="skip-link" href="#main">
  {m.header.skipLink}
</a>
<header class="header container">
  <a class="home" href={`${home}#top`}>
    {m.header.home}
  </a>
  <nav aria-label={m.header.navLabel}>
    <ul>
      {m.header.nav.map(({ href, label }) => (
        <li>
          <a href={`${home}${href}`}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="actions">
    {alternates.map((alternate) => (
      <a class="language" href={alternate.href} hreflang={alternate.locale} lang={alternate.locale}>
        {alternate.label}
      </a>
    ))}
    <a class="btn resume" href="/alex-wade-resume.pdf" type="application/pdf" target="_blank" rel="noopener">
      {m.header.resume}
      <span class="visually-hidden">{m.glance.newTab}</span>
    </a>
  </div>
</header>

<style>
  .header {
    /*
     * How far the bar's backdrop sits inside the header's 24px padding. The bottom keeps 2px more, because the
     * shadow and the progress line make the space below the links look smaller than it is.
     */
    --bar-top: 8px;
    --bar-bottom: 6px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 24px;
    /* Sticks once the top inset has scrolled away, so the backdrop meets the top of the screen. */
    position: sticky;
    top: calc(-1 * var(--bar-top));
    z-index: 5;
  }

  /*
   * The bar's backdrop, full-bleed although the header itself is container width; body clips the overflow. It is
   * inset equally top and bottom, so the stuck bar is shorter than the resting header and the content stays centred.
   */
  .header::before,
  .header::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    pointer-events: none;
  }

  .header::before {
    inset-block: var(--bar-top) var(--bar-bottom);
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      0 1px 0 rgb(23 32 46 / 0.06),
      0 8px 20px -12px rgb(23 32 46 / 0.18);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  /* controls.js sets data-stuck. Without it, the bar is always on so text never scrolls under bare letters. */
  .header[data-stuck]::before,
  html:not([data-js]) .header::before {
    opacity: 1;
  }

  /* Reading progress: a redline that draws across the bottom of the bar as the page scrolls. */
  .header::after {
    bottom: var(--bar-bottom);
    height: 2px;
    background: var(--redline);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* Tied to scroll position, so it tracks the scrollbar exactly. Browsers without scroll timelines skip it. */
  @supports (animation-timeline: scroll()) {
    .header::after {
      animation: header-progress linear both;
      animation-timeline: scroll();
    }
  }

  @keyframes header-progress {
    to {
      transform: none;
    }
  }

  .home {
    padding-block: 12px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .language {
    display: block;
    padding-block: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .language:hover {
    color: var(--redline);
  }

  .resume {
    border-color: var(--redline);
    color: var(--redline);
    text-decoration: none;
  }

  .resume:hover {
    background: var(--redline);
    color: var(--paper);
  }

  /* On phones, keep the language and résumé links beside the name and give the nav its own row. */
  @media (max-width: 600px) {
    nav {
      flex-basis: 100%;
      order: 1;
    }

    /*
     * Two rows is too tall to keep on a phone screen, so the name row scrolls away and only the nav row sticks. The
     * backdrop starts 8px above the nav (24px padding + the 44px row + the 12px gap - 8px) and ends 10px below it.
     */
    .header {
      --bar-top: 72px;
      --bar-bottom: 14px;
    }
  }

  nav a {
    display: block;
    padding-block: 12px;
    text-decoration: none;
  }
</style>
