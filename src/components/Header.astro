---
import { t } from "../i18n";

interface Props {
  /** Prefix for the in-page nav links, so they work from other pages. */
  base?: string;
  showSpecToggle?: boolean;
}

const { base = "", showSpecToggle = false } = Astro.props;
const m = t().header;
---

<a class="skip-link" href="#main">
  {m.skipLink}
</a>
<header class="header container">
  <a class="home" href={`${base}#top`}>
    {m.home}
  </a>
  <nav aria-label={m.navLabel}>
    <ul>
      {m.nav.map(({ href, label }) => (
        <li>
          <a href={`${base}${href}`}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
  {showSpecToggle && (
    <button type="button" class="btn spec-toggle js-only" data-toggle="spec">
      <span data-when="off">{m.specShow}</span>
      <span data-when="on">{m.specHide}</span>
    </button>
  )}
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 24px;
  }

  .home {
    padding-block: 12px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  nav a {
    display: block;
    padding-block: 12px;
    text-decoration: none;
  }
</style>
