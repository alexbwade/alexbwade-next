---
import { t, toLocale } from "../i18n";

const locale = toLocale(Astro.currentLocale);
const m = t(locale).work;
---

<section id="work" class="container" aria-labelledby="work-label">
  <div class="section">
    <h2 id="work-label" class="section-label">
      {m.label}
    </h2>
    {m.groups.map((group) => (
      <div class="group">
        <h3>{group.title}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              <div class="title">{item.title}</div>
              <p class:list={["body", { todo: item.body.startsWith("TODO") }]}>{item.body}</p>
              <div class="meta">{item.meta}</div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 80px;
    padding-block: 40px;
    border-top: 1px solid var(--rule);
  }

  .group:first-of-type {
    padding-top: 32px;
    border-top: 0;
  }

  .group:last-of-type {
    padding-bottom: 0;
  }

  h3 {
    flex: 1 1 300px;
    text-wrap: balance;
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  ul {
    display: flex;
    flex: 1.6 1 480px;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .title {
    font-size: 20px;
    font-weight: 500;
  }

  .body {
    max-width: 58ch;
    margin: 6px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--slate);
  }

  /* Placeholder copy is meant to be noticed on the preview. */
  .todo {
    color: var(--redline);
  }

  .meta {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
