---
import { t } from "../i18n";

const m = t().hero;
---

<section id="top" class="hero container">
  <h1>
    <span class="visually-hidden">{m.srHeadline}</span>
    <span aria-hidden="true">
      <span class="line">
        <span class="lead">{m.lead}</span>
      </span>
      <span class="line">
        <span>
          {m.before}{" "}
          <span class="rotator">
            {m.rotating.map((word) => (
              <span>{word}</span>
            ))}
          </span>
        </span>
      </span>
      <span class="line">
        <span>{m.after}</span>
      </span>
    </span>
  </h1>
</section>

<style>
  .hero {
    padding-block: 88px 40px;
  }

  h1 {
    margin: 0;
    font-size: var(--text-h1);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .lead {
    color: var(--lead);
  }

  .rotator {
    color: var(--redline);
  }
</style>
