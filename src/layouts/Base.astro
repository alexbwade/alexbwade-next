---
import { Font } from "astro:assets";
import { transform } from "esbuild";
import controlsSource from "../scripts/controls.js?raw";
import { cleanPath, defaultLocale, localePath, locales, t, toLocale, unlocalizedPath } from "../i18n";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  /** False for the 404 page: no canonical URL or language alternates, and a noindex hint. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const m = t(locale);
const site = Astro.site ?? new URL("https://www.alexbwade.com");
const path = unlocalizedPath(cleanPath(Astro.url.pathname));
const canonical = new URL(localePath(locale, path), site).href;
// The same page in every language, for hreflang. x-default points search engines at English.
const alternates: { hreflang: string; href: string }[] = [
  ...locales.map((other) => ({ hreflang: other, href: new URL(localePath(other, path), site).href })),
  { hreflang: "x-default", href: new URL(localePath(defaultLocale, path), site).href },
];
const { code: controlsScript } = await transform(controlsSource, { minify: true, target: "es2022" });
const ogImage = new URL(localePath(locale, "/og.png"), site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: m.meta.siteName,
  jobTitle: m.meta.jobTitle,
  worksFor: { "@type": "Organization", name: "Lightspeed Systems" },
  address: { "@type": "PostalAddress", addressLocality: "Portland", addressRegion: "OR", addressCountry: "US" },
  image: ogImage,
  url: new URL(localePath(locale, "/"), site).href,
  sameAs: ["https://www.linkedin.com/in/alexbwade"],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FAFBFC" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.meta.ogImageAlt} />
    <meta property="og:locale" content={m.meta.ogLocale} />
    {locales
      .filter((other) => other !== locale)
      .map((other) => (
        <meta property="og:locale:alternate" content={t(other).meta.ogLocale} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload={[{ weight: "500" }]} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <script is:inline set:html={controlsScript} />
  </head>
  <body>
    <slot />
  </body>
</html>
